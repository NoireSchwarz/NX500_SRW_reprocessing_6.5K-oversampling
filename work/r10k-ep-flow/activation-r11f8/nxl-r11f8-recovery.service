[Unit]
Description=NX500 R11f8 recovery handoff outside camera service
DefaultDependencies=no
IgnoreOnIsolate=yes
ConditionPathExists=/run/nxl-r11f8-recovery/expected-phase

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/
ExecStart=/bin/sh /run/nxl-r11f8-recovery/recovery.sh worker
TimeoutSec=60
